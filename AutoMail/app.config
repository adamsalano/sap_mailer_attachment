<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup>
  <!-- One entry per company; the name is the company database. Keys: Server (NDB@host:port), SapUser, SapPassword
       (Service Layer login), DbUser, DbPassword (HANA), CreateFields (Y/N), optional ServiceLayerUrl.
       Wrap a value containing ; or = in single quotes.
       Encrypt on the server by running OAF_AutoMail.exe with the protect-credentials switch (see Program.cs). -->
  <connectionStrings>
    <add name="OAF_KE" connectionString="Server=NDB@saphana02.oneacrefund.org:30013;SapUser=manager;SapPassword=S@p6DUKA?;DbUser=OAFSAPAdmin;DbPassword=F@rmers1stFor3v3r!!;CreateFields=Y"/>
    <add name="OAF_RW" connectionString="Server=NDB@saphana02.oneacrefund.org:30013;SapUser=manager;SapPassword=S@p6DUKA?;DbUser=OAFSAPAdmin;DbPassword=F@rmers1stFor3v3r!!;CreateFields=Y"/>
  </connectionStrings>
  <appSettings>
    <!-- Any setting marked [per company] can be overridden for one company database by adding a key
         with the database name as suffix, e.g. <add key="EmailJobs.KE_LIVE" value="GoodsIssue,Delivery"/> -->

    <!-- ===== Jobs ===== -->
    <!-- [per company] Attach the Crystal PDF to the SAP document (flag U_PDFAttach).
         Available: GoodsReceipt, GoodsReceiptPO, GoodsIssue, SalesReturn, Delivery, PurchaseReturn, InventoryTransfer -->
    <add key="AttachJobs" value="GoodsReceipt,GoodsReceiptPO,GoodsIssue,SalesReturn,Delivery,PurchaseReturn,InventoryTransfer"/>
    <!-- [per company] Email the PDF to the warehouse receivers in OWHS.U_RcvMailId (flag U_MailSend).
         Available: the attach jobs above plus SalesOrder, IssueForProduction, ReceiptFromProduction, InventoryCount -->
    <add key="EmailJobs" value="SalesOrder, IssueForProduction, ReceiptFromProduction, InventoryCount"/>
    <!-- [per company] Available: OutgoingPayments, TransferNotifications -->
    <add key="NotificationJobs" value="OutgoingPayments"/>

    <!-- ===== Only documents dated on/after these dates are processed (yyyy-MM-dd) [per company] ===== -->
    <add key="AttachFromDate" value="2026-01-01"/>
    <!-- Required before enabling EmailJobs. Set it to the go-live date, otherwise old documents get emailed. -->
    <add key="EmailFromDate" value="2026-09-07"/>
    <!-- Set to the go-live date on purpose: older exported payments not yet flagged U_MailSend='Y' would
         otherwise all be emailed to vendors on the first run. Move it back only after checking that backlog. -->
    <add key="OutgoingPaymentsFromDate" value="2026-05-01"/>
    <add key="TransferNotificationsFromDate" value=""/>
    <!-- [per company] Reply-To of remittance advice emails; vendors' replies go here. -->
    <add key="PaymentsReplyTo" value="AP.Finance@oneacrefund.org"/>
    <!-- [per company] Crystal report in the Report folder used for remittance advices. -->
    <add key="Report.OutgoingPayments" value="Outgoing Payment_New.rpt"/>

    <!-- HANA procedure names for the jobs converted from SQL Server; change if the HANA versions are named differently. -->
    <add key="Procedure.SalesOrder" value="OAF_L_TMS"/>
    <add key="Procedure.IssueForProduction" value="OAF_L_Issue_Production"/>
    <add key="Procedure.ReceiptFromProduction" value="OAF_L_Receipt_Production"/>
    <add key="Procedure.InventoryCount" value="OAF_L_Inventory_Count"/>

    <!-- ===== Parallelism ===== -->
    <!-- Companies processed at the same time. -->
    <add key="MaxParallelCompanies" value="3"/>
    <!-- Run each company in its own worker process. Crystal renders only one PDF at a time per process, so this
         multiplies PDF throughput, and a crash in one company no longer stops the others. -->
    <add key="ProcessPerCompany" value="true"/>
    <!-- Job groups processed at the same time inside one company. Each worker opens its own HANA connection
         and Service Layer session, so total sessions = companies x jobs at peak. -->
    <add key="MaxParallelJobsPerCompany" value="3"/>
    <!-- Maximum documents per job per run (0 = no limit). -->
    <add key="BatchSize" value="500"/>

    <!-- ===== Connections ===== -->
    <!-- {host} is taken from the company's Server. A ServiceLayerUrl key in its connection string overrides this per company. -->
    <add key="ServiceLayerUrl" value="https://{host}:50000/b1s/v1"/>
    <!-- Service Layer normally ships with a self-signed certificate. Install it in the machine's
         Trusted Root store and set this to false. -->
    <add key="TrustServiceLayerCertificate" value="true"/>
    <add key="SmtpHost" value="smtp.gmail.com"/>
    <add key="SmtpPort" value="587"/>
    <!-- Testing only: when set, every email goes to this address instead of the real To/CC (they are shown in
         the subject). Leave empty in production. -->
    <add key="TestRecipient" value=""/>
    <add key="LogDirectory" value="C:\LOG\PDF"/>
  </appSettings>
</configuration>
